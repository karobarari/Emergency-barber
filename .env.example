# Public URL of the site (no trailing slash), used for Stripe redirects
SITE_URL=http://localhost:3000

# Supabase (Project settings → API). Service role key stays server-side only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys, and the webhook signing secret)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Telegram: create a bot with @BotFather, add it to a group with your barbers,
# then put the group chat id here (starts with -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random string; Telegram sends it back so we know callbacks are genuine
TELEGRAM_WEBHOOK_SECRET=
# Optional: your private chat with the bot (get your ID from @userinfobot, then press Start on the bot).
# Error alerts go here instead of the barbers' group.
TELEGRAM_ALERT_CHAT_ID=

# Shared with Supabase Vault (name cron_secret) so only pg_cron can call /api/cron. Any long random string.
CRON_SECRET=

# Twilio SMS to customers (optional: leave blank to skip texts while testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dispatch page password (/admin, any username)
ADMIN_PASSWORD=

# Barbers shown on the assign buttons, comma separated
BARBER_NAMES=Karo ,Joe ,Oscar
# Optional: each barber's Telegram user id (from @userinfobot), same order as BARBER_NAMES. When set, only that
# barber can tap their own Accept button, and only the barber who took a job can tap Done or No-show.
BARBER_TELEGRAM_IDS=

# Out-of-hours window, London time. First slot (shop closing time) and last slot.
OPEN_FROM=19:00
LAST_SLOT=00:00

# How many days after today customers can book (Stripe card holds expire after 7 days, so keep this at 6 or less)
ADVANCE_DAYS=6

# Capacity: barbers working each night, and chairs at the shop. Home and hotel visits always leave one barber for the shop.
BARBER_COUNT=3
SHOP_CHAIRS=1

# Home visits (SPEC-v2 Phase 4). "At my place" shows as coming soon until VERIFY_TOKEN_SECRET and ROUTING_API_KEY are set.
# Optional: texts a code to prove the number. Leave empty to take the number as typed.
# Twilio Console → Verify → Services → create one, copy its SID (VA...). Uses the Twilio account above.
TWILIO_VERIFY_SERVICE_SID=
# Any long random string; signs the 30-minute "phone verified" cookie
VERIFY_TOKEN_SECRET=
# OpenRouteService (openrouteservice.org, free tier) API key, for drive times from the shop
ROUTING_API_KEY=
