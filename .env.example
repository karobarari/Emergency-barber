# Public URL of the site (no trailing slash), used for Stripe redirects
SITE_URL=http://localhost:3000

# Supabase (Project settings → API). Service role key stays server-side only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys, and the webhook signing secret)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Telegram: create a bot with @BotFather, add it to a group with your barbers,
# then put the group chat id here (starts with -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random string; Telegram sends it back so we know callbacks are genuine
TELEGRAM_WEBHOOK_SECRET=

# Twilio SMS to customers (optional: leave blank to skip texts while testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dispatch page password (/admin, any username)
ADMIN_PASSWORD=

# Barbers shown on the assign buttons, comma separated
BARBER_NAMES=Karo,Barber 2,Barber 3

# Out-of-hours window, London time. First slot (shop closing time) and last slot.
OPEN_FROM=19:00
LAST_SLOT=00:00
